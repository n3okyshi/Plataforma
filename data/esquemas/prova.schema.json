{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "prova.schema.json",
  "title": "prova",
  "type": "object",
  "required": [
    "id",
    "titulo",
    "componente",
    "tema",
    "nivel",
    "unidade",
    "bncc",
    "questoes",
    "pontuacaoTotal",
    "criterios",
    "matriz",
    "instrucoes",
    "fontes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "componente": {
      "type": "string",
      "minLength": 1
    },
    "nivel": {
      "type": "string",
      "pattern": "^(EI0[1-3]|EF0[1-9]|EM0[1-3])$"
    },
    "unidade": {
      "type": "string",
      "minLength": 1
    },
    "bncc": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(EF[0-9]{2}[A-Z]{2}[0-9]{2}|EM[0-9]{2}(?:[A-Z]{3}[0-9]{3}|(?:LP|CO)[0-9]{2})|EI[0-9]{2}[A-Z]{2}[0-9]{2})$"
      }
    },
    "fontes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "documento"
        ],
        "properties": {
          "documento": {
            "type": "string",
            "minLength": 1
          },
          "paginasPdf": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "paginasImpressas": {
            "type": "string",
            "minLength": 1
          },
          "uso": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "titulo": {
      "type": "string",
      "minLength": 1
    },
    "tema": {
      "type": "string",
      "minLength": 1
    },
    "questoes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pontuacaoTotal": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "duracaoMin": {
      "type": "integer",
      "minimum": 1
    },
    "criterios": {
      "type": "string",
      "minLength": 1
    },
    "instrucoes": {
      "type": "string",
      "minLength": 1
    },
    "matriz": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "bncc",
          "questoes"
        ],
        "properties": {
          "bncc": {
            "type": "string",
            "minLength": 1
          },
          "questoes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "estado": {
      "enum": [
        "rascunho",
        "piloto",
        "publicado"
      ]
    },
    "avaliacaoPratica": {
      "$ref": "atividade.schema.json"
    }
  }
}
