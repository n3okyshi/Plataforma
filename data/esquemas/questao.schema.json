{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "questao.schema.json",
  "title": "questao",
  "type": "object",
  "required": [
    "id",
    "componente",
    "tema",
    "nivel",
    "unidade",
    "aulaId",
    "bncc",
    "tipo",
    "formato",
    "pergunta",
    "opcoes",
    "correta",
    "explicacao",
    "fontes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "componente": {
      "type": "string",
      "minLength": 1
    },
    "nivel": {
      "type": "string",
      "pattern": "^(EI0[1-3]|EF0[1-9]|EM0[1-3])$"
    },
    "unidade": {
      "type": "string",
      "minLength": 1
    },
    "bncc": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(EF[0-9]{2}[A-Z]{2}[0-9]{2}|EM[0-9]{2}[A-Z]{3}[0-9]{3}|EI[0-9]{2}[A-Z]{2}[0-9]{2})$"
      }
    },
    "fontes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "documento"
        ],
        "properties": {
          "documento": {
            "type": "string",
            "minLength": 1
          },
          "paginasPdf": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "paginasImpressas": {
            "type": "string",
            "minLength": 1
          },
          "uso": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tema": {
      "type": "string",
      "minLength": 1
    },
    "aulaId": {
      "type": "string",
      "minLength": 1
    },
    "tipo": {
      "enum": [
        "treino",
        "prova"
      ]
    },
    "formato": {
      "const": "multipla_escolha"
    },
    "pergunta": {
      "type": "string",
      "minLength": 1
    },
    "opcoes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "correta": {
      "type": "integer",
      "minimum": 0
    },
    "explicacao": {
      "type": "string",
      "minLength": 1
    },
    "dificuldade": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "estado": {
      "enum": [
        "rascunho",
        "piloto",
        "publicado"
      ]
    }
  }
}
