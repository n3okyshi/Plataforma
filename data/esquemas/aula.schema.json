{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aula.schema.json",
  "title": "aula",
  "type": "object",
  "required": [
    "id",
    "componente",
    "nivel",
    "ordem",
    "unidade",
    "titulo",
    "bncc",
    "conteudo",
    "atividades",
    "fontes",
    "metadados"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "componente": {
      "type": "string",
      "minLength": 1
    },
    "nivel": {
      "type": "string",
      "pattern": "^(EI0[1-3]|EF0[1-9]|EM0[1-3])$"
    },
    "unidade": {
      "type": "string",
      "minLength": 1
    },
    "bncc": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(EF[0-9]{2}[A-Z]{2}[0-9]{2}|EM[0-9]{2}[A-Z]{3}[0-9]{3}|EI[0-9]{2}[A-Z]{2}[0-9]{2})$"
      }
    },
    "fontes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "documento"
        ],
        "properties": {
          "documento": {
            "type": "string",
            "minLength": 1
          },
          "paginasPdf": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "paginasImpressas": {
            "type": "string",
            "minLength": 1
          },
          "uso": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "titulo": {
      "type": "string",
      "minLength": 1
    },
    "ordem": {
      "type": "integer",
      "minimum": 1
    },
    "duracaoMin": {
      "type": "integer",
      "minimum": 1
    },
    "dificuldade": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "conteudo": {
      "type": "object",
      "required": [
        "objetivos",
        "resumo",
        "blocos"
      ],
      "properties": {
        "objetivos": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "resumo": {
          "type": "string"
        },
        "blocos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tipo",
              "html"
            ],
            "properties": {
              "tipo": {
                "const": "html"
              },
              "html": {
                "type": "string"
              }
            }
          }
        },
        "vocabulario": {
          "type": "array"
        },
        "errosComuns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "atividades": {
      "type": "array",
      "items": {
        "$ref": "atividade.schema.json"
      }
    },
    "preRequisitos": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proximosPassos": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadados": {
      "type": "object",
      "required": [
        "estado",
        "revisado"
      ],
      "properties": {
        "estado": {
          "enum": [
            "rascunho",
            "piloto",
            "publicado"
          ]
        },
        "revisado": {
          "type": "boolean"
        },
        "autor": {
          "type": "string",
          "minLength": 1
        },
        "versao": {
          "type": "integer",
          "minimum": 1
        },
        "revisao": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
